          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="2. cache.addAll of the&lt;br&gt;precache list&lt;br&gt;(connect-src 'self')" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#15803d;strokeWidth=2;fontSize=12;fontColor=#15803d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="host" target="sw">
